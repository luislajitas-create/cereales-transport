# Copiá este archivo a ".env" (mismo directorio) y ajustá lo que haga falta.
# ".env" real nunca se commitea (ver .gitignore) y NUNCA debe contener valores de producción.

# Postgres local — estos son los mismos valores de ejemplo que ya usa docker-compose.yml
# para desarrollo. Si tu Postgres local tiene otro usuario/contraseña/puerto, ajustalos acá.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cereal_db?schema=public"

# Generá un secreto propio — por ejemplo con: openssl rand -hex 32
# Nunca reutilices el mismo valor entre entornos, y nunca uno que ya haya aparecido en el
# historial del repositorio (ver backend/src/config/env-validation.ts).
JWT_SECRET="reemplazar-por-un-secreto-propio-de-al-menos-16-caracteres"

# Debe coincidir con el puerto real del frontend local (ver frontend/vite.config.ts).
CORS_ORIGIN="http://localhost:5173"

PORT=3000
